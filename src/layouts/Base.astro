---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, NAV, LINKS } from '../consts';

interface Props {
  /** Page title. Omit on the home page to use the site title alone. */
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;

const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;

// Normalize trailing slashes so "/blog/" and "/blog" both highlight the nav.
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  return target === '/' ? current === '/' : current === target || current.startsWith(`${target}/`);
};

const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>

  <body>
    <header class="masthead">
      <p class="name"><a href="/">{SITE_TITLE}</a></p>
      <nav>
        {
          NAV.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        {LINKS.map((link, i) => (
          <>
            {i > 0 && ' · '}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
        {' · '}
        <a href="/rss.xml">rss</a>
      </p>
      <p>© {year} {SITE_TITLE}</p>
    </footer>
  </body>
</html>
