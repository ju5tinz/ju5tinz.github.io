---
import Base from '../layouts/Base.astro';

/**
 * Add a project by appending an entry here. Every field except `name`
 * and `blurb` is optional.
 */
const projects = [
  {
    name: 'Homepage',
    href: 'https://github.com/ju5tinz/ju5tinz.github.io',
    blurb:
      'This site. Static HTML generated by Astro, no client-side JavaScript, deployed to GitHub Pages on push.',
    tags: ['astro', 'typescript'],
    year: '2026',
  },
  {
    name: 'Example Project',
    href: null,
    blurb:
      'Replace this entry with something real. Keep the blurb to a sentence or two — what it does and why it was interesting to build.',
    tags: ['placeholder'],
    year: '2026',
  },
];
---

<Base title="Projects" description="Things I've built.">
  <h1>Projects</h1>

  <p>Things I've built. Most of them are on <a href="https://github.com/ju5tinz">GitHub</a>.</p>

  <ul class="entries">
    {
      projects.map((project) => (
        <li>
          <div>
            <span class="title">
              {project.href ? <a href={project.href}>{project.name}</a> : project.name}
            </span>
            {project.year && <span class="meta"> · {project.year}</span>}
            {project.tags && project.tags.length > 0 && (
              <span class="meta"> · {project.tags.join(', ')}</span>
            )}
          </div>
          <p class="summary">{project.blurb}</p>
        </li>
      ))
    }
  </ul>
</Base>
