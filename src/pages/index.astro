---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base>
  <h1>I'm Justin.</h1>

  <p>
    I enjoy exploring the intersection of art and technology.
  </p>

  <p>
    Here are my random musings on things I'm working on.
  </p>

  <h2>Writing</h2>

  {
    posts.length === 0 ? (
      <p class="muted">Nothing published yet.</p>
    ) : (
      <ul class="entries">
        {posts.map((post) => (
          <li>
            <div>
              <span class="title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </span>
              <span class="meta"> · {formatDate(post.data.date)}</span>
            </div>
            {post.data.description && <p class="summary">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
</Base>
